GROQ_API_KEY=

PINECONE_API_KEY=
LLAMA_PARSER_API_KEY=

TAVILY_API_KEY=
# API server
# API_HOST and API_PORT control the uvicorn bind.
#   - Native dev:     API_HOST=127.0.0.1
#   - Docker compose: API_HOST=0.0.0.0   (set by docker-compose.yml)
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false

CORS_ORIGINS=http://localhost:8501

# Auth
JWT_SECRET=dev-only-change-me
JWT_EXPIRY_MINUTES=60

POSTGRES_DSN=
